{"nodes": [{"id": "docs_design_3d_mesh_catalog_and_custom_land_builder_designguide", "label": "3D Mesh Catalog & Procedural Land Builder Design Guide", "file_type": "document", "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L1-L252", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_3d_mesh_catalog_and_custom_land_builder_4tierpipeline", "label": "4-Tier 3D Asset & Procedural Island Pipeline", "file_type": "rationale", "rationale": "Replaces monolithic GLB scenes (park.glb ~3.5MB, cozy_lake.glb ~15MB) and manual Blender authoring with a 4-tier pipeline (Scanner, Slicer, AssetRepository, ProceduralLandBuilder) so teachers configure new islands in Google Sheets with low mobile VRAM and bandwidth.", "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L13-L51", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_3d_mesh_catalog_and_custom_land_builder_meshcatalogschema", "label": "MeshCatalogItem Schema & Heuristic Semantic Classifier", "file_type": "concept", "rationale": "Standardizes 181 extracted meshes in public/data/meshCatalog.json across 6 semantic categories (TERRAIN, FOLIAGE, PROP, OBSTACLE, CHARACTER, ENVIRONMENT) with regex name classification, AABB bounds, normalizedDimensions, and obstacleRadius.", "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L55-L100", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_3d_mesh_catalog_and_custom_land_builder_prefabslicer", "label": "Prefab Slicer & Coordinate/Pivot Baking", "file_type": "concept", "rationale": "Bakes parent-child world transforms, inverse-transpose normal matrices, and base pivot (Y_min=0, centered X=0/Z=0) while running @gltf-transform prune() so 180 standalone GLBs are 20-80 KB and sit flush on terrain.", "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L104-L122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_3d_mesh_catalog_and_custom_land_builder_vramsharingdeepclone", "label": "Lazy Prefab Loading, VRAM Deep Cloning & Placeholder Fallback", "file_type": "rationale", "rationale": "Loads each prefab GLB once into cache and shares GPU BufferGeometry and Material across cloned THREE.Group instances, while generating low-poly category-colored placeholders on network failure to prevent crashes.", "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L125-L150", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_3d_mesh_catalog_and_custom_land_builder_procedurallandbuilder", "label": "ProceduralLandBuilder (PROCEDURAL_SANCTUARY)", "file_type": "concept", "rationale": "Dynamically builds PBR islands (grass top plate 0x10b981, sandstone cliff base 0x4a3728, rim sand 0xd9c58c) from Google Sheets ZONES rows supporting 4 themes (FOREST, GARDEN, RUINS, VILLAGE) and 3 densities (LOW 8-12, MEDIUM 16-24, HIGH 26-38).", "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L154-L176", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_3d_mesh_catalog_and_custom_land_builder_seededlcgprng", "label": "Deterministic Seeded LCG PRNG", "file_type": "rationale", "rationale": "Uses Linear Congruential Generator X_{n+1} = (1664525*X_n + 1013904223) mod 2^32 seeded by zone.id hash so island props and trees never shift positions across reloads or devices.", "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L179-L182", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_3d_mesh_catalog_and_custom_land_builder_keepoutzones", "label": "Keep-Out Zones Spatial Clearance", "file_type": "rationale", "rationale": "Enforces >=3.5m clearance around Return Portal, >=2.2m around Knowledge Monoliths, and >=2.5m between large obstacles to guarantee unobstructed navigation and question interaction.", "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L183-L186", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_3d_mesh_catalog_and_custom_land_builder_sheetszoneworkflow", "label": "Google Sheets Teacher Island Workflow (ZONES & PROBLEMS)", "file_type": "concept", "rationale": "Enables non-programmer teachers to publish new 3D islands by adding ZONES rows (>=80m apart) and matching zoneId questions in PROBLEMS.", "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L220-L242", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_design_3d_mesh_catalog_and_custom_land_builder_designguide", "target": "docs_design_3d_mesh_catalog_and_custom_land_builder_4tierpipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L18-L51", "weight": 1.0}, {"source": "docs_design_3d_mesh_catalog_and_custom_land_builder_4tierpipeline", "target": "docs_design_3d_mesh_catalog_and_custom_land_builder_meshcatalogschema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L22-L25", "weight": 1.0}, {"source": "docs_design_3d_mesh_catalog_and_custom_land_builder_4tierpipeline", "target": "docs_design_3d_mesh_catalog_and_custom_land_builder_prefabslicer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/3d-mesh-catalog-and-custom-land-builder.md", "source_location": "L30-L32", "weight": 