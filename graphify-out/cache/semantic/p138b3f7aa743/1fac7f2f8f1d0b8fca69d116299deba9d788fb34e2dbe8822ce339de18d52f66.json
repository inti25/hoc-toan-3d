{"nodes": [{"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_researchdoc", "label": "QHMJ_SANCTUARY Interactions & Dynamic Questions Research Doc", "file_type": "document", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L1-L360", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_qhmjsanctuary", "label": "QHMJ_SANCTUARY (map_qhmj.glb)", "file_type": "concept", "rationale": "Multi-elevation 3D sanctuary (306 nodes, 111 meshes, QHMJ_SCALE=16) using a close-up third/first-person camera (fov=58, distance=2.4) over narrow ~3.8m winding roads.", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L1-L55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_roadsurface5islands", "label": "RoadSurface 5 Road Islands & Overpass Overlap", "file_type": "concept", "rationale": "4,013 triangles welded at 0.8m into 5 disjoint road clusters (Island 4 spawn/portal y=0.27-8.04m, Island 2, Island 3 castle plaza, Island 1 main axis 3,068 tris, Island 0 summit y=23.88-29.26m) with 460 2mx2m grid cells exhibiting >=3.0m vertical overpass overlap.", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L56-L70", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_jumplinkgraph", "label": "12 JumpLink Graph (10 GLB + 2 Synthetic Pads)", "file_type": "concept", "rationale": "Connects the 5 road islands via 10 comm_jumpt_* GLB jump pads plus 2 synthetic return links (Links 10, 11) so every island can be reached from Island 4 and returned from.", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L71-L91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_qhmjlandmarks", "label": "QHMJ Landmarks (Gears, Giant Clock, Fans, Forest, Castle)", "file_type": "concept", "rationale": "Maps uneven GLB mesh distribution: 3 gear bone clusters (7 skinned meshes) on Island 1 west, giant clock Object_55 suspended at y=34.11, 2 fans, 6 forest props map_daoju_02*, and 7 castle plaza flowers common_qhmj_hua* on Island 3.", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L92-L146", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_3tierelevationmodel", "label": "3-Tier Elevation + Jump-Pad Gatekeeping + Summit Model (Idea 4)", "file_type": "rationale", "rationale": "Solves arbitrary Sheets question counts (N=1..40+, max capacity 80-145 nodes) and theme-agnostic questions by splitting into Tier 1 (Island 4+2, cap 15), Tier 2 (Island 1 via Farthest-Point Sampling 3D), and Tier 3 (Island 3+0, cap 27) with slender non-blocking crystals.", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L180-L206", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_antisoftlockrule", "label": "Jump-Pad Gatekeeping Anti-Soft-Lock Rule", "file_type": "rationale", "rationale": "Keeps Link 2 (Island 4 -> Island 2) unlocked whenever Tier 1 exceeds 4 questions and never locks synthetic links (10, 11) or downward links (5-9) so players can never become trapped on an upper island.", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L190-L194", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_qhmjquestionsources", "label": "3-Source QHMJ Question Pipeline (Sheets, Apps Script, Fallback)", "file_type": "concept", "rationale": "Falls back from Google Sheets QHMJ_Map (with optional PosY) to Apps Script ZONE_TEMPLATES.QHMJ_SANCTUARY to seeded client generateQhmjProblems() outputting standardized RemoteProblem steps (ADR 0013).", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L209-L260", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_surfaceanchoring", "label": "anchorQhmjProblemsToSurface 3D Placement", "file_type": "concept", "rationale": "Anchors QhmjInteractiveNodes (jump_gate, path_crystal, clock_summit) onto RoadSurface using hasClearance(0.9), >=4.0m 3D exclusion from spawn/returnPortal, >=3.5m from jump targets, and sampleNearest() clamping for manual PosX/PosZ.", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L261-L275", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_3draycastandproximity", "label": "3D Raycast & 3D Proximity Overpass Disambiguation", "file_type": "rationale", "rationale": "Replaces Plane(y=0) clicks and 2D (x,z) checks with Three.js mesh raycasting and 3D proximity (|dy|<=2.5m) because 460 RoadSurface cells have overlapping road tiers >=3m apart.", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L46-L69", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_qhmjprogressandbadges", "label": "Namespaced QHMJ Progress, Zone Badges (>5) & SaveState.position.y", "file_type": "concept", "rationale": "Namespaces solvedProblems keys as qhmj_<zoneId>_<id> to avoid colliding with Flower/Park IDs 1..20, removes the zoneId <= 5 cap for zoneBadges, and persists optional position.y so multi-tier reload teleportation does not drop players onto Island 4.", "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L276-L358", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_researchdoc", "target": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_qhmjsanctuary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L1-L55", "weight": 1.0}, {"source": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_qhmjsanctuary", "target": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_roadsurface5islands", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L56-L70", "weight": 1.0}, {"source": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_qhmjsanctuary", "target": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_jumplinkgraph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L71-L91", "weight": 1.0}, {"source": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_qhmjsanctuary", "target": "docs_design_qhmj_sanctuary_interactions_and_dynamic_questions_qhmjlandmarks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/qhmj-sanctuary-interactions-and-dynamic-questions.md", "source_location": "L92-L146", "weight": 1.0}, {"source": "docs_design_q