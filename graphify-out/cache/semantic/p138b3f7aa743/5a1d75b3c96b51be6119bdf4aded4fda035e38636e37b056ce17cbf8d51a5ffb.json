{"nodes": [{"id": "docs_design_zone_scene_isolation_and_portal_loading_researchreport", "label": "Zone Scene Isolation & Portal Loading Technical Report", "file_type": "document", "source_file": "docs/design/zone-scene-isolation-and-portal-loading.md", "source_location": "L1-L245", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_zone_scene_isolation_and_portal_loading_eagerallinonescenebottleneck", "label": "Eager All-in-One Scene Bottleneck", "file_type": "concept", "rationale": "Mounting park.glb (6.45MB), farm.glb (448.6KB), 5 cozy_lake.glb clones (330 meshes/680 nodes), procedural islands, and 40+ monoliths in one THREE.Scene forces Object3D.updateMatrixWorld() traversal even when visible=false plus 60Hz farm/collision loops.", "source_file": "docs/design/zone-scene-isolation-and-portal-loading.md", "source_location": "L14-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_zone_scene_isolation_and_portal_loading_regioncontainerarch", "label": "Single THREE.Scene + Active Region Container (Option B)", "file_type": "rationale", "rationale": "Retains one root THREE.Scene for player, lights, fog, and SceneBatchPool while mounting only the active zone's RegionContainer THREE.Group via scene.remove/add and renderer.compileAsync(nextGroup, camera, scene), avoiding reparenting issues and preserving render pipeline test contracts.", "source_file": "docs/design/zone-scene-isolation-and-portal-loading.md", "source_location": "L16-L106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_zone_scene_isolation_and_portal_loading_regionboundaries", "label": "Region Partitioning Boundaries (CORE_VILLAGE_GARDEN & Lazy Regions)", "file_type": "concept", "rationale": "Keeps Starter Village, Friendship Bridge, and Flower Garden together as CORE_VILLAGE_GARDEN (0 KB map GLBs on boot) due to continuous river bridge sightlines, while lazy-loading Archimedes Hub, Lake, Park, Farm, and Procedural islands behind portals.", "source_file": "docs/design/zone-scene-isolation-and-portal-loading.md", "source_location": "L17-L94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_zone_scene_isolation_and_portal_loading_worldregioninterface", "label": "WorldRegion Controller Descriptor", "file_type": "concept", "rationale": "Deep module interface encapsulating id, group, shadowBounds, per-region obstacles and portals, update(), and optional dispose() / LRU eviction.", "source_file": "docs/design/zone-scene-isolation-and-portal-loading.md", "source_location": "L107-L118", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_zone_scene_isolation_and_portal_loading_portalloadinglifecycle", "label": "Portal Loading Lifecycle & Anti-Flicker Transition", "file_type": "concept", "rationale": "Replaces synchronous SpatialWorld teleport with onPortalTransitRequested -> paused input -> #loading paint yield (rAF) + 200-250ms anti-flicker -> ensureLoaded + compileAsync -> region swap -> teleport + error recovery.", "source_file": "docs/design/zone-scene-isolation-and-portal-loading.md", "source_location": "L121-L182", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_zone_scene_isolation_and_portal_loading_portalprefetchfix", "label": "Portal Prefetch Metadata Fix (targetRegionKind)", "file_type": "rationale", "rationale": "Replaces brittle portalId substring checks (which failed to prefetch cozy_lake on hub_to_z1..z5 and erroneously preloaded 6.45MB park.glb on z*_to_village return portals) with explicit targetRegionKind metadata on PortalLink.", "source_file": "docs/design/zone-scene-isolation-and-portal-loading.md", "source_location": "L50-L54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_zone_scene_isolation_and_portal_loading_dynamicshadowbounds", "label": "Dynamic Per-Region Shadow Camera Bounds", "file_type": "rationale", "rationale": "Shrinks DirectionalLight shadow frustum from 295x180m (~0.29 m/texel) to ~64x64m around active region.center (with sun.target attached to scene), boosting shadow sharpness ~4.5x and reducing shadow pass work.", "source_file": "docs/design/zone-scene-isolation-and-portal-loading.md", "source_location": "L42-L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_zone_scene_isolation_and_portal_loading_deferredspawnandmapfallbacks", "label": "Deferred Spawn (ADR 0007) & Unloaded Map Dialog Fallbacks", "file_type": "concept", "rationale": "Resolves targetRegionId on launch to load only the saved region during #loading, and decouples openArchimedesMapDialog and #travel from unloaded 3D meshes via FLOWER_COORDS and computeProceduralEntityPositions.", "source_file": "docs/design/zone-scene-isolation-and-portal-loading.md", "source_location": "L187-L203", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_zone_scene_isolation_and_portal_loading_workboxcacheexpansion", "label": "VRAM LRU Policy & Workbox 3d-models-cache Expansion", "file_type": "concept", "rationale": "Retains shared small assets in AssetRepository while allowing evictRegion() on heavy park.glb, and recommends raising Workbox maxEntries from 50 to 150-200 so ~180 prefabs do not evict primary maps offline.", "source_file": "docs/design/zone-scene-isolation-and-portal-loading.md", "source_location": "L211-L218", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_design_zone_scene_isolation_and_portal_loading_researchreport", "target": "docs_design_zone_scene_isolation_and_portal_loading_eagerallinonescenebottleneck", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design/zone-scene-isolat