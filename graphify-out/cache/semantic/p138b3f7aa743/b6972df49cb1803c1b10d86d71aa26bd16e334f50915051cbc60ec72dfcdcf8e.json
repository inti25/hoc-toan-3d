{"nodes": [{"id": "docs_adr_0014_farm_sanctuary_3d_countryside_and_close_exploration_camera_dual_asset_composition", "label": "Dual-Asset Countryside Composition (scene.gltf + farm.glb) (ADR 0014)", "file_type": "rationale", "source_file": "docs/adr/0014-farm-sanctuary-3d-countryside-and-close-exploration-camera.md", "source_location": "L1-L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pairs the rich unlit countryside scene.gltf (~220x165 m) with rigged animals, shelters, and produce from farm.glb, superseding ADR 0012's flat 32m circular meadow."}, {"id": "docs_adr_0014_farm_sanctuary_3d_countryside_and_close_exploration_camera_roadsurface_and_farmcollidergrid", "label": "RoadSurface & Jumpable FarmColliderGrid", "file_type": "rationale", "source_file": "docs/adr/0014-farm-sanctuary-3d-countryside-and-close-exploration-camera.md", "source_location": "L16-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses a 0.9 m spatial hash grid over vertical/diagonal structure triangles instead of bloated diagonal Box3 bounds, skipping overhead roofs (> groundY + 2.2m) and letting players jump over low wooden fences."}, {"id": "docs_adr_0014_farm_sanctuary_3d_countryside_and_close_exploration_camera_hybrid_homeward_walk", "label": "18 Animal Anchors & Hybrid Homeward Walk", "file_type": "rationale", "source_file": "docs/adr/0014-farm-sanctuary-3d-countryside-and-close-exploration-camera.md", "source_location": "L20-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caps long countryside homeward returns (>35 m) to a 4.5s cheer-run plus sparkle-warp to FARM_PEN_ENTRY_LOCAL so rescue completion never stalls."}, {"id": "docs_adr_0014_farm_sanctuary_3d_countryside_and_close_exploration_camera_shared_close_camera", "label": "Shared Close Exploration Camera Mode", "file_type": "rationale", "source_file": "docs/adr/0014-farm-sanctuary-3d-c